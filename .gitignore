build/
dist/
*.spec.bak
packaging/output/
*.exe
*.zip
SHA256SUMS.txt

# Launch/marketing drafts -- kept local on purpose, not part of the product.
promo/

# Local-only promo/marketing working material, not part of the product
promo/
screenshots/Gemini_Generated_Image_*

# Full-size screen recording; the committed demo is SwitchAgent-demo.gif
screenshots/SwitchAgent.gif

